<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.miro_app">

    <!-- ==================== PERMISSIONS ==================== -->
    <!-- REQUIRED: Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera (untuk image_picker — foto langkah misi & ganti avatar) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Galeri foto — READ_MEDIA_IMAGES buat Android 13+ (granular media
         permission), READ/WRITE_EXTERNAL_STORAGE buat Android 12 ke bawah
         doang (dibatasi maxSdkVersion biar nggak minta izin storage
         lawas yang nggak dipakai lagi di Android modern). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- RECORD_AUDIO dulu ada di sini "buat audio features" — app ini
         nggak punya fitur rekam suara/speech-to-text sama sekali (dicek:
         nggak ada package speech_to_text/audio recorder, nggak ada
         pemakaian di kode Dart manapun). Minta izin mikrofon yang nggak
         pernah dipakai itu masalah kepercayaan nyata buat app anak-anak
         — orang tua yang lihat app anaknya minta akses mikrofon tanpa
         alasan jelas wajar curiga, dan bisa kena tinjauan lebih ketat di
         Play Store Families Policy / Data Safety form. Dihapus. -->

    <!-- ==================== APPLICATION ==================== -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="false"
        android:allowBackup="true"
        android:fullBackupContent="true">

        <!-- ==================== MAIN ACTIVITY ==================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <!-- Flutter UI Theme -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <!-- Splash Screen (Pre-Android 12) -->
            <meta-data
                android:name="io.flutter.embedding.android.SplashScreenDrawable"
                android:resource="@drawable/launch_background" />

            <!-- Main Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ Flutter Plugin Registry -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

    <!-- ==================== QUERIES (Android 11+) ==================== -->
    <!-- ✅ Required untuk Flutter plugins & system features -->
    <queries>
        <!-- Process Text Plugin -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>

        <!-- Text-to-Speech Service -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>

        <!-- Camera Intent -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>

        <!-- Gallery/Image Picker -->
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>

        <!-- View Documents -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>

        <!-- Google Play Store (optional) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>